APP_NAME=ARGUS Core API
APP_ENV=development
API_CORS_ORIGINS=http://localhost:5173

API_PORT=8000
MONGO_PORT=27017
MONGO_DATABASE=argus
MONGO_ROOT_USERNAME=argus_admin
MONGO_ROOT_PASSWORD=argus_local_password_2026
CAMERA_HEARTBEAT_TIMEOUT_SECONDS=15
CAMERA_TASK_COOLDOWN_SECONDS=60

# Cámara que usará el agente Edge.
CAMERA_ID=CAM-001
CAMERA_NAME=Camera Laptop Gustavo
CAMERA_TYPE=integrated
CAMERA_SOURCE=0
EDGE_PORT=8081
EDGE_STREAM_URL=http://localhost:8081/stream
IOT_SEGMENT=iot-cameras
MOTION_ENABLED=true
MOTION_THRESHOLD=18
MOTION_COOLDOWN_SECONDS=5

# Rendimiento del agente Edge.
CAPTURE_WIDTH=1280
CAPTURE_HEIGHT=720
CAPTURE_FPS=30
CAPTURE_BUFFER_SIZE=1
JPEG_QUALITY=82
DETECTION_ENABLED=false
VISION_MODE=motion
DETECTION_MODEL=yolo11n.pt
DETECTION_INTERVAL=3
DETECTION_INPUT_SIZE=640
DETECTION_DEVICE=
DETECTION_CONFIDENCE=0.45
